# Copy to .env.local for local Next.js (`npm run dev`).
# Never commit real keys.

# anthropic (default) | bedrock
LLM_PROVIDER=anthropic

# From Claude Console → API keys
ANTHROPIC_API_KEY=

# Optional override (default: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL_ID=claude-haiku-4-5-20251001

# Only when LLM_PROVIDER=bedrock and AWS has approved Bedrock
# BEDROCK_MODEL_ID=eu.anthropic.claude-3-haiku-20240307-v1:0
