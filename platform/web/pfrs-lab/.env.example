# Copy to .env.local only if you ever run the assistant locally.
# Never commit real keys.

# anthropic (default) | bedrock
LLM_PROVIDER=anthropic

# Production: key lives in SSM SecureString (lazy-loaded).
# CI syncs GitHub secret ANTHROPIC_API_KEY → this parameter on deploy.
ANTHROPIC_API_KEY_SSM=/pfrs-lab/production/anthropic-api-key

# Local-only override (skips SSM). Prefer not using this in production Lambda env.
# ANTHROPIC_API_KEY=

# Optional model override (default: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL_ID=claude-haiku-4-5-20251001
